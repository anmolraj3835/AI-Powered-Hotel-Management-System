# Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# Supabase Project Settings
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# The following are SERVER-SIDE ONLY (Supabase Edge Functions)
# Never put these in the frontend .env file
# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  (Edge Functions only)
# RESEND_API_KEY=your-resend-api-key                (Edge Functions only)
